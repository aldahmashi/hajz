# Copy to .env for local development. Never commit .env.
APP_ENV=local
LOG_LEVEL=INFO
PORT=8000

# host:user:password:port:database  (local Docker MySQL from docker-compose.yml)
MYSQL_DB=127.0.0.1:root:hajz_local:3307:hajz
# Optional read-only replica, same format. Empty = use MYSQL_DB.
MYSQL_DB_RO=
# Path to a CA bundle for TLS (required for TiDB Cloud in production).
DB_SSL_CA=

ALLOWED_ORIGINS=http://localhost:4302,http://127.0.0.1:4302
